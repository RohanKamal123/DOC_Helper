# Supabase project (free tier) — Settings > API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tavily (free tier, ~1000 searches/month) — app.tavily.com
TAVILY_API_KEY=

# NOTE: there is intentionally no DeepSeek key here. Each user pastes their own
# DeepSeek API key in the browser UI; it is sent to /api/chat per request and
# is never stored server-side.
